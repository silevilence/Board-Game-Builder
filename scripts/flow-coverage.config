<Configuration>
  <CodeCoverage>
    <ModulePaths><Include><ModulePath>.*(Kernel|Kernel.Abstractions|Runtime|Authoring|Editor|Editor.Core)\.dll$</ModulePath></Include></ModulePaths>
    <Sources>
      <Include><Source>.*[\\/](Flow[^\\/]*|GameEngine|Replay|PlaySession|GameRuntime|RuntimeComposition|RunOperations|ValidationOperations|DebugSession|SessionController|AuthorWorkspace|DocumentWorkspace|ExportWorkflow|ExportPanel|FormatPanel|EditorApplication|EditorHost)\.cs$</Source></Include>
      <Exclude><Source>.*[\\/]FlowVerification\.cs$</Source></Exclude>
    </Sources>
  </CodeCoverage>
</Configuration>
