<Configuration>
  <CodeCoverage>
    <ModulePaths><Include><ModulePath>.*(Editor|Editor.Core|Authoring|Runtime)\.dll$</ModulePath></Include></ModulePaths>
    <Sources><Include><Source>.*[\/](Flow[^\/]*|ExportWorkflow|ExportPanel|FormatPanel|EditorApplication|EditorHost)\.cs$</Source></Include><Exclude><Source>.*FlowVerification\.cs$</Source></Exclude></Sources>
  </CodeCoverage>
</Configuration>
