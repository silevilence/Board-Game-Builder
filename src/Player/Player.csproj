<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework><ApplicationManifest>../app.manifest</ApplicationManifest></PropertyGroup>
  <PropertyGroup>
    <EnableEditorDebug Condition="'$(EnableEditorDebug)' == ''">true</EnableEditorDebug>
    <DefineConstants Condition="'$(EnableEditorDebug)' == 'true'">$(DefineConstants);EDITOR_DEBUG</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(EnableEditorDebug)' != 'true'"><Compile Remove="DebugPlayerWindow.cs" /></ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Runtime/Runtime.csproj" />
    <ProjectReference Include="../View.MonoGame/View.MonoGame.csproj" />
  </ItemGroup>
  <Target Name="UseSeparateLuaWorkerDistribution" BeforeTargets="_HandleFileConflictsForPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.RelativePath)' == 'Lua.exe' Or '%(ResolvedFileToPublish.RelativePath)' == 'Lua.deps.json' Or '%(ResolvedFileToPublish.RelativePath)' == 'Lua.runtimeconfig.json'" />
    </ItemGroup>
  </Target>
</Project>
