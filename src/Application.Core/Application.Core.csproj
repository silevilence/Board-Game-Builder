<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><IsAotCompatible>true</IsAotCompatible></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Application.Abstractions/Application.Abstractions.csproj" />
    <PackageReference Include="CordiSharp" Version="[0.2.0]" ExcludeAssets="analyzers" Condition="'$(UseStaticRuntime)' != 'true'" />
    <Reference Include="CordiSharp" Condition="'$(UseStaticRuntime)' == 'true'">
      <HintPath>$(MSBuildThisFileDirectory)../../artifacts/native-aot/cordisharp/CordiSharp.dll</HintPath>
    </Reference>
  </ItemGroup>
  <Target Name="RequireStaticRuntime" BeforeTargets="ResolveReferences" Condition="'$(UseStaticRuntime)' == 'true'">
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)../../artifacts/native-aot/cordisharp/CordiSharp.dll')" Text="Build the pinned static runtime with third_party/CordiSharp/build-static.ps1 first." />
  </Target>
</Project>
