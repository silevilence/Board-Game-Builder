<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework><ApplicationManifest>../app.manifest</ApplicationManifest></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Editor.Core/Editor.Core.csproj" />
    <ProjectReference Include="../Runtime/Runtime.csproj" />
    <ProjectReference Include="../Application.Debug/Application.Debug.csproj" />
    <ProjectReference Include="../../samples/Sample.Motion/Sample.Motion.csproj" />
    <ProjectReference Include="../View.MonoGame/View.MonoGame.csproj" />
  </ItemGroup>
  <ItemGroup><PackageReference Include="CordiSharp.Plugins.Avalonia" Version="[0.2.0]" /></ItemGroup>
  <Target Name="UseSeparateLuaWorkerDistribution" BeforeTargets="_HandleFileConflictsForPublish">
    <ItemGroup><ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.RelativePath)' == 'Lua.exe' Or '%(ResolvedFileToPublish.RelativePath)' == 'Lua.deps.json' Or '%(ResolvedFileToPublish.RelativePath)' == 'Lua.runtimeconfig.json'" /></ItemGroup>
  </Target>
</Project>
