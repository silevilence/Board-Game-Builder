{
  "format": 1,
  "id": "flow-supply",
  "version": "1.0.0",
  "plugins": [
    {
      "id": "definition.module",
      "version": "1",
      "api": 1,
      "configuration": {
        "path": "module.json"
      }
    },
    {
      "id": "kernel",
      "version": "1",
      "api": 1,
      "configuration": {}
    },
    {
      "id": "flow",
      "version": "1",
      "api": 1,
      "configuration": {
        "path": "flow.json",
        "maxAutomaticSteps": 32
      }
    },
    {
      "id": "session.local",
      "version": "1",
      "api": 1,
      "configuration": {}
    },
    {
      "id": "recording",
      "version": "1",
      "api": 1,
      "configuration": {}
    },
    {
      "id": "resources",
      "version": "1",
      "api": 1,
      "configuration": {
        "sources": [
          {
            "path": "player.json",
            "name": "player.presentation"
          },
          {
            "path": "board.json",
            "name": "board.presentation"
          }
        ]
      }
    },
    {
      "id": "board.render",
      "version": "1",
      "api": 1,
      "configuration": {}
    }
  ]
}
